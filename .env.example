# YouCam (Perfect Corp) Skin Analysis API key — server-side only, never exposed to the client.
# Get one at https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# Anthropic API key — server-side only, never exposed to the client.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase project URL and anon (public) key — safe for client-side use.
# Row Level Security enforces access; never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" to use the real YouCam scan instead of mock data (src/lib/skinAnalysisService.ts).
VITE_ENABLE_REAL_SCAN=false

# Demo Mode build (src/lib/demoMode.ts) — every visitor's data lives only in
# their own browser's localStorage (src/lib/data/localStore.ts); Anthropic,
# YouCam, and Supabase are never called. Defaults to "true" so a fresh clone
# with none of the keys above filled in still runs the full app immediately,
# with zero setup. Set to "false" (and fill in the keys above) to run against
# the real Anthropic/YouCam/Supabase stack instead.
VITE_DEMO_BUILD=true
